          "Nur teilweise oder falsch zugeordnet",
          "Alle vier Bauteile richtig benannt und zugeordnet"
        ]
      },
      {
        "criterion": "Aufgabe erklärt",
        "levels": [
          "Aufgabe fehlt oder nur 'hält die Brücke'",
          "Aufgabe im Sinne des Lastwegs erklärt (aufnehmen / weiterleiten / nach unten)"
        ]
      }
    ],
    "solution_steps": [],
