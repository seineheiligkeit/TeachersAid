            "answer_key": "O = 72 cm²",
            "acceptable_reasoning": null,
            "rubric": [],
            "solution_steps": [
              {
                "text": "Die sechs Flächen zu drei kongruenten Paaren ordnen",
                "expr": "O = 2ab + 2ac + 2bc"
              },
              {
                "text": "Kantenlängen einsetzen",
                "expr": "O = 2 \\cdot 3 \\cdot 6 + 2 \\cdot 3 \\cdot 2 + 2 \\cdot 6 \\cdot 2"
              },
              {
                "text": "Teilflächen addieren",
                "expr": "O = 36 + 12 + 24 = 72"
              }
            ],
