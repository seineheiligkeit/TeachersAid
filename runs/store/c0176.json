                  "author_death_year": null,
                  "quote_span": null
                }
              ],
              "attribution_required": false,
              "share_alike_applies": false
            },
            "role": "info",
            "kind": "key_fact",
            "content": [
              {
                "text": "Bedeutung — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Die Wiener Ordnung sicherte den Großmächten über Jahrzehnte den Frieden und prägte die europäische Politik. Zugleich unterdrückte sie liberale und nationale Bewegungen — Stabilität für die Herrschenden, Rückschritt für die Mitbestimmung.",
                "mark": null,
                "ref_block": null,
                "math": false
              }
            ],
            "callout_role": null,
            "teacher_note": null,
            "watch_outs": [],
            "numbered": true
          },
          {
            "id": "sv.gegenwart",
            "optional": false,
            "modality": "printable",
            "flags": null,
            "asset_refs": [],
            "provenance": {
              "expression_origin": "original",
              "sources": [
                {
                  "title": "Wiener Kongress",
                  "url": "https://de.wikipedia.org/w/index.php?title=Wiener_Kongress&oldid=267935028",
