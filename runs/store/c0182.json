        "blocks": [
          {
            "id": "sv.d1",
            "optional": false,
            "modality": "printable",
            "flags": null,
            "asset_refs": [],
            "provenance": {
              "expression_origin": "original",
              "sources": [
                {
                  "title": "Blutkreislauf",
                  "url": "https://de.wikipedia.org/wiki/Blutkreislauf",
                  "publisher": "Wikipedia (de)",
