            "content": [
              {
                "text": "Ein Land, sehr ungleich besiedelt — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Die Menschen verteilen sich in Österreich sehr ungleich über das Land. Im Großraum Wien und in den großen Tälern leben viele Menschen dicht beieinander, während in den Gebirgsregionen nur wenige wohnen.",
                "mark": null,
                "ref_block": null,
                "math": false
              }
            ],
            "callout_role": null,
            "teacher_note": null,
            "watch_outs": [],
            "numbered": true
