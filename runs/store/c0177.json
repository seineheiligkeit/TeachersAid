            "role": "info",
            "kind": "key_fact",
            "content": [
              {
                "text": "Gegenwartsbezug — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Wachsen die Ballungsräume weiter, steigen dort Mieten und Verkehr, während ländliche Regionen mit Abwanderung kämpfen. Wie man Wohnraum schafft, ohne immer mehr Boden zu verbrauchen, ist eine der großen Fragen der Raumplanung.",
                "mark": null,
                "ref_block": null,
                "math": false
