          "timing_notes": null
        },
        "blocks": [
          {
            "id": "sv.d1",
            "optional": false,
            "modality": "printable",
            "flags": null,
            "asset_refs": [],
            "provenance": {
              "expression_origin": "original",
              "sources": [
                {
                  "title": "Industrielle Revolution",
                  "url": "https://de.wikipedia.org/wiki/Industrielle_Revolution",
                  "publisher": "Wikipedia (de)",
