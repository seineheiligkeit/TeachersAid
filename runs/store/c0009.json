                  "quote_span": null
                }
              ],
              "attribution_required": false,
              "share_alike_applies": false
            },
            "role": "info",
            "kind": "prose",
            "content": [
              {
                "text": "Bevor die Maschinen kamen — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Lange Zeit stellten die Menschen ihre Waren mit der Hand her, in kleinen Werkstätten oder zu Hause. Wer Stoff brauchte, spann den Faden am Spinnrad und webte ihn von Hand. Erst neue Maschinen begannen, diese Handarbeit zu ersetzen und die Industrialisierung in Gang zu bringen.",
                "mark": null,
                "ref_block": null,
                "math": false
              }
            ],
            "callout_role": null,
            "teacher_note": null,
            "watch_outs": [],
            "numbered": true
          },
          {
            "id": "sv.d2",
            "optional": false,
            "modality": "printable",
            "flags": null,
            "asset_refs": [],
            "provenance": {
              "expression_origin": "original",
              "sources": [
                {
                  "title": "Industrielle Revolution",
                  "url": "https://de.wikipedia.org/wiki/Industrielle_Revolution",
                  "publisher": "Wikipedia (de)",
                  "licence": "CC-BY-SA-4.0",
                  "licence_url": "https://creativecommons.org/licenses/by-sa/4.0/",
                  "retrieved": "2026-06-30",
                  "role": "facts",
                  "redistributable": false,
                  "author_death_year": null,
                  "quote_span": null
                }
              ],
              "attribution_required": false,
              "share_alike_applies": false
            },
            "role": "info",
            "kind": "prose",
            "content": [
              {
                "text": "Die Kraft des Dampfes — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Der entscheidende Schritt war die Dampfmaschine. James Watt verbesserte sie 1769 so weit, dass sie zuverlässig und kräftig genug war, um ganze Fabriken anzutreiben. Schon davor hatte James Hargreaves um 1764 mit der Spinning Jenny eine frühe mechanische Spinnmaschine gebaut, die viele Fäden zugleich spann. Nun musste eine Maschine nicht mehr am Fluss stehen, denn der Dampf lieferte die Kraft fast überall.",
                "mark": null,
                "ref_block": null,
                "math": false
              }
            ],
            "callout_role": null,
            "teacher_note": null,
            "watch_outs": [],
            "numbered": true
          },
          {
            "id": "sv.d3",
            "optional": false,
            "modality": "printable",
            "flags": null,
            "asset_refs": [],
            "provenance": {
              "expression_origin": "original",
              "sources": [
                {
                  "title": "Industrielle Revolution",
                  "url": "https://de.wikipedia.org/wiki/Industrielle_Revolution",
                  "publisher": "Wikipedia (de)",
                  "licence": "CC-BY-SA-4.0",
                  "licence_url": "https://creativecommons.org/licenses/by-sa/4.0/",
                  "retrieved": "2026-06-30",
                  "role": "facts",
                  "redistributable": false,
                  "author_death_year": null,
                  "quote_span": null
                }
              ],
              "attribution_required": false,
              "share_alike_applies": false
            },
            "role": "info",
            "kind": "prose",
            "content": [
              {
                "text": "Arbeit zieht in die Fabrik — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Mit den Maschinen wanderte die Arbeit aus der Werkstatt zu Hause in große Fabriken, in denen viele Menschen zusammen herstellten, was zuvor Handarbeit war. Weil die Fabriken viele Arbeitskräfte an einem Ort brauchten, zogen Männer, Frauen und Kinder vom Land in die Städte. Diese wuchsen dadurch rasch an, was man Urbanisierung nennt.",
                "mark": null,
                "ref_block": null,
                "math": false
              }
            ],
            "callout_role": null,
            "teacher_note": null,
            "watch_outs": [],
            "numbered": true
          },
          {
            "id": "sv.d4",
            "optional": false,
            "modality": "printable",
            "flags": null,
            "asset_refs": [],
            "provenance": {
              "expression_origin": "original",
              "sources": [
                {
                  "title": "Industrielle Revolution",
                  "url": "https://de.wikipedia.org/wiki/Industrielle_Revolution",
                  "publisher": "Wikipedia (de)",
                  "licence": "CC-BY-SA-4.0",
                  "licence_url": "https://creativecommons.org/licenses/by-sa/4.0/",
                  "retrieved": "2026-06-30",
                  "role": "facts",
                  "redistributable": false,
                  "author_death_year": null,
                  "quote_span": null
                }
              ],
              "attribution_required": false,
              "share_alike_applies": false
            },
            "role": "info",
            "kind": "prose",
            "content": [
              {
                "text": "Die Eisenbahn verbindet das Land — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Auch der Verkehr wurde durch die Dampfkraft umgewälzt. George Stephenson eröffnete 1825 mit der Strecke Stockton-Darlington die erste öffentliche Dampf-Eisenbahn, und 1830 verband die Bahn Liverpool und Manchester. In Österreich fuhr 1837 zwischen Floridsdorf und Deutsch-Wagram der erste Dampfzug. So konnten Waren, Rohstoffe und Menschen nun schneller und billiger weite Strecken zurücklegen.",
                "mark": null,
                "ref_block": null,
                "math": false
              }
            ],
            "callout_role": null,
            "teacher_note": null,
            "watch_outs": [],
            "numbered": true
          },
          {
            "id": "sv.d5",
            "optional": false,
            "modality": "printable",
            "flags": null,
            "asset_refs": [],
            "provenance": {
              "expression_origin": "original",
              "sources": [
                {
                  "title": "Industrielle Revolution",
                  "url": "https://de.wikipedia.org/wiki/Industrielle_Revolution",
                  "publisher": "Wikipedia (de)",
                  "licence": "CC-BY-SA-4.0",
                  "licence_url": "https://creativecommons.org/licenses/by-sa/4.0/",
                  "retrieved": "2026-06-30",
                  "role": "facts",
                  "redistributable": false,
                  "author_death_year": null,
                  "quote_span": null
                }
              ],
              "attribution_required": false,
              "share_alike_applies": false
            },
            "role": "info",
            "kind": "prose",
            "content": [
              {
                "text": "Licht und Schatten — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Die Industrialisierung brachte mehr Waren, neue Berufe und wachsende Städte. Zugleich arbeiteten in den Fabriken viele Menschen lange Stunden gegen geringen Lohn, und auch Kinder mussten mitarbeiten. Aus dieser Not entstand der Streit über die soziale Frage.",
                "mark": null,
                "ref_block": null,
                "math": false
              }
            ],
            "callout_role": null,
            "teacher_note": null,
            "watch_outs": [],
            "numbered": true
          },
          {
            "id": "sv.bedeutung",
            "optional": false,
            "modality": "printable",
            "flags": null,
            "asset_refs": [],
            "provenance": {
              "expression_origin": "original",
              "sources": [
                {
                  "title": "Industrielle Revolution",
                  "url": "https://de.wikipedia.org/wiki/Industrielle_Revolution",
                  "publisher": "Wikipedia (de)",
                  "licence": "CC-BY-SA-4.0",
                  "licence_url": "https://creativecommons.org/licenses/by-sa/4.0/",
                  "retrieved": "2026-06-30",
                  "role": "facts",
                  "redistributable": false,
                  "author_death_year": null,
                  "quote_span": null
                }
              ],
              "attribution_required": false,
              "share_alike_applies": false
            },
            "role": "info",
            "kind": "key_fact",
            "content": [
              {
                "text": "Bedeutung — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Die Industrialisierung veränderte das Leben tiefgreifender als fast jede Umwälzung zuvor: Maschinen, Fabriken und Eisenbahnen schufen neue Berufe, ließen Städte wachsen und steigerten die Menge der hergestellten Waren gewaltig. Zugleich entstand eine große Arbeiterschaft, deren harte Lebensbedingungen zur sogenannten sozialen Frage wurden.",
                "mark": null,
                "ref_block": null,
                "math": false
              }
            ],
            "callout_role": null,
            "teacher_note": null,
            "watch_outs": [],
            "numbered": true
          },
          {
            "id": "sv.gegenwart",
            "optional": false,
            "modality": "printable",
            "flags": null,
            "asset_refs": [],
            "provenance": {
              "expression_origin": "original",
              "sources": [
                {
                  "title": "Industrielle Revolution",
                  "url": "https://de.wikipedia.org/wiki/Industrielle_Revolution",
                  "publisher": "Wikipedia (de)",
                  "licence": "CC-BY-SA-4.0",
                  "licence_url": "https://creativecommons.org/licenses/by-sa/4.0/",
                  "retrieved": "2026-06-30",
                  "role": "facts",
                  "redistributable": false,
                  "author_death_year": null,
                  "quote_span": null
                }
              ],
              "attribution_required": false,
              "share_alike_applies": false
            },
            "role": "info",
            "kind": "key_fact",
            "content": [
              {
                "text": "Gegenwartsbezug — ",
                "mark": "bold",
                "ref_block": null,
                "math": false
              },
              {
                "text": "Fabriken, Eisenbahnen und maschinelle Massenproduktion prägen unsere Welt bis heute, und viele Großstädte gehen auf diese Zeit zurück. Auch der Streit darüber, wie Arbeit gerecht entlohnt und Mensch und Umwelt geschützt werden, begann damals und ist bis heute aktuell.",
                "mark": null,
                "ref_block": null,
                "math": false
              }
            ],
            "callout_role": null,
            "teacher_note": null,
            "watch_outs": [],
            "numbered": true
          },
