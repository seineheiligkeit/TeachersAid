            "est_minutes": 10,
            "answer_key": [
              {
                "text": "\\text{H}(-3 \\mid 1), \\; \\text{T}(-1 \\mid -3), \\; W(-2 \\mid -1)",
                "mark": null,
                "ref_block": null,
                "math": true
              }
            ],
            "acceptable_reasoning": null,
            "rubric": [],
            "solution_steps": [
              {
                "text": "Funktion",
                "expr": "f(x) = x^{3} + 6 x^{2} + 9 x + 1"
              },
              {
                "text": "1. Ableitung; Extremstellen aus f'(x) = 0",
                "expr": "f'(x) = 3 x^{2} + 12 x + 9 = 0 \\Rightarrow x \\in \\{-3, -1\\}"
              },
              {
                "text": "2. Ableitung; Art über das Vorzeichen von f''",
                "expr": "f''(x) = 6 \\left(x + 2\\right)"
              },
              {
                "text": "Extrempunkte",
                "expr": "\\text{Hochpunkt}\\,(-3 \\mid 1);\\; \\text{Tiefpunkt}\\,(-1 \\mid -3)"
              },
              {
                "text": "Wendestelle aus f''(x) = 0",
                "expr": "f''(x) = 0 \\Rightarrow x = -2,\\quad W(-2 \\mid -1)"
              }
            ],
            "watch_outs": [],
            "self_check": null
          },
