            "prompt": [
              {
                "text": "Führe eine Kurvendiskussion durch: Bestimme alle Extrem- und Wendepunkte von ",
                "mark": null,
                "ref_block": null,
                "math": false
              },
              {
                "text": "f(x) = x^{3} + 6 x^{2} + 9 x + 1",
                "mark": null,
